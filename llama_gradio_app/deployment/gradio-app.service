[Unit]
Description=Llama Gradio App
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/ishtar-ai.com/llama_gradio_app
ExecStart=/var/www/ishtar-ai.com/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker --timeout 300 --bind 127.0.0.1:8000 wsgi:application
Restart=always
StandardOutput=journal
StandardError=journal
Environment="PATH=/var/www/ishtar-ai.com/venv/bin"
Environment="PYTHONPATH=/var/www/ishtar-ai.com"

[Install]
WantedBy=multi-user.target 